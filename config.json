{
  "standard": 20,
  "vcpkg": {
    "windows": "D:/vcpkg",
    "linux": "~/vcpkg"
  },
  "graphviz": {
    "windows": "D:/Graphviz",
    "linux": "/usr"
  },
  "dependency": {
    "postgresql": {
      "switch": true
    },
    "mysql": {
      "switch": true
    },
    "sqlite3": {
      "switch": true,
      "cipher": true
    },
    "hiredis": {
      "switch": true
    },
    "zlib": {
      "switch": true
    },
    "lz4": {
      "switch": true
    },
    "zstd": {
      "switch": true
    },
    "icu": {
      "switch": true
    }
  },
  "feature": {
    "locale": true,
    "io_uring": true,
    "memory-pool-global-override": true
  },
  "build": {
    "tests": true,
    "examples": true,
    "benchmarks": true,
    "docs": true
  },
  "isa": {
    "x64": {
      "level": "AVX2",
      "extensions": {
        "aes-ni": true,
        "pclmul": true,
        "vaes": true,
        "intel-tsx": false
      }
    },
    "aarch64": {
      "level": "BASELINE",
      "extensions": {
        "aes": true
      }
    },
    "riscv64": {
      "level": "BASELINE",
      "extensions": {}
    },
    "loongarch64": {
      "level": "BASELINE",
      "extensions": {}
    }
  }
}
