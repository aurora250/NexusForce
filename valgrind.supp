# Valgrind Suppressions for NexusForceUnitTests
# 用法: valgrind --suppressions=valgrind.supp --leak-check=full ./tests/unit/NexusForceUnitTests
#
# 此文件抑制以下非项目代码错误:
# 1. glibc TLS 误报 — pthread_create / aio_create_helper_thread 内部分配
# 2. GTest 死亡测试产物 — fork()子进程中未清理的 VirtualThreadEnvironment 线程资源
# 3. glibc wcsxfrm_l 内部 AVX2 越界读取 — 仅在 clang++ 构建中出现
# 4. glibc 动态加载器 _dl_find_object 查找表缓存 — dlopen 后由 ld.so 持有且从不释放
# 5. glibc setenv/__add_to_environ 环境表簿记 — unsetenv 后查找树残留的内部指针

# =============================================================================
# glibc TLS (Thread Local Storage) 误报
# =============================================================================
# pthread_create 通过 allocate_stack -> _dl_allocate_tls -> allocate_dtv 分配
# 每个线程的 DTV (Dynamic Thread Vector)。glibc 不复用已退出线程的 TLS 槽以优化
# 线程创建性能，Valgrind 报告为 possibly lost，属已知误报。
# 注意: 需要两个 calloc 帧因为 glibc 内部调用链包含两层 calloc
# 注意: 函数名带 @@GLIBC 版本后缀
# =============================================================================

{
   glibc_tls_pthread_create
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@GLIBC_2.34
}

{
   glibc_tls_pthread_create_malloc
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@GLIBC_2.34
}

# =============================================================================
# glibc TLS 误报 — aio 异步 IO 辅助线程
# =============================================================================
# file_async::read 调用 aio_read 可能创建 glibc 内部辅助线程，
# 同样触发 TLS 分配，同为 glibc 已知误报
# =============================================================================

{
   glibc_tls_aio_helper_thread
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@GLIBC_2.34
   fun:__aio_create_helper_thread
}

# =============================================================================
# GTest 死亡测试产物 — virtual_thread 线程数据
# =============================================================================
# 全局 VirtualThreadEnvironment::SetUp() 调用 virtual_thread::initialize(1)
# 创建 1 个 worker 线程。死亡测试 (EXPECT_DEATH / EXPECT_DEBUG_DEATH) 通过
# fork() 创建子进程，子进程故意触发 SIGABRT 以验证死亡断言。
# 在 fork 的子进程中，继承自父进程的 worker 线程无法正常 join/析构，
# 导致 make_unique 分配的 thread_data (24 bytes) 被报告为 definitely lost。
# 仅在 forked+crash 的子进程中发生，主进程正常退出时无此泄漏。
# =============================================================================

{
   gtest_death_virtual_thread_worker
   Memcheck:Leak
   match-leak-kinds: definite
   fun:_Znwm
   ...
   fun:_ZN7neforce24virtual_thread_scheduler13start_workers*
   fun:_ZN7neforce14virtual_thread10initialize*
   ...
}

# =============================================================================
# glibc __cxa_thread_atexit_impl — 线程退出处理器分配
# =============================================================================
# 当 thread_local 对象存在析构函数时，glibc 在首次创建 thread_local 时
# 通过 __cxa_thread_atexit_impl 分配退出处理器条目。
# 在 fork 的子进程中，父进程工作线程的此分配无法访问 (definitely lost)。
# 正常线程 exit() 会正确释放。
# =============================================================================

{
   glibc_cxa_thread_atexit_impl
   Memcheck:Leak
   match-leak-kinds: definite
   fun:calloc
   fun:__cxa_thread_atexit_impl
   fun:__cxa_thread_atexit
   ...
}

# =============================================================================
# glibc wcsxfrm_l 内部 AVX2 越界读取
# =============================================================================
# locale::collation_key 调用 wcsxfrm_l 进行字符串排序键计算，
# glibc 内部 __wcpncpy_avx2 以 32 字节对齐块 (YMM 寄存器) 读取，
# 当内部分配缓冲区末尾未对齐时，最后一个 AVX2 加载越过边界。
# 仅在 clang++ AVX2 优化路径中出现，非项目代码可修复。
# collation_key = 13 字符，mangled: _ZNK7neforce6locale13collation_key*
# =============================================================================

{
   glibc_wcsxfrm_l_buffer_overread
   Memcheck:Addr32
   fun:__wcpncpy_avx2
   fun:wcsxfrm_l
   fun:_ZNK7neforce6locale13collation_key*
}

# =============================================================================
# glibc 动态加载器 _dl_find_object 查找表缓存
# =============================================================================
# plugin_manager::load_plugin -> dynamic_library::open -> dlopen 会让 ld.so 扩展
# 其 _dl_find_object 地址查找表：dl-find-object.c 的 _dl_find_object_update() 通过
# _dlfo_mappings_segment_allocate() 追加映射段，这些段由加载器自身持有且从不释放
# (进程生命周期缓存，glibc 有意不回收)，Valgrind 只看到加载器内部的间接引用，
# 因而报 possibly lost (实测 full suite 中 11 个进程各 4,608 字节 / 2 块)。
# 非项目代码可释放，且仅在 dlopen 之后出现。
# =============================================================================

{
   glibc_dlopen_find_object_cache
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:_dlfo_mappings_segment_allocate
   ...
   fun:dl_open_worker*
   ...
}

# =============================================================================
# glibc setenv / __add_to_environ 环境表簿记
# =============================================================================
# environment::set -> setenv 在 glibc 内部维护 "NAME=VALUE" 字符串以及用于加速
# getenv 的 known_values 查找树 (setenv.c: __add_to_environ -> tsearch)。变量被
# unsetenv 从 environ 移除后，树中残留的指针指向块的中部，Valgrind 只能看到
# interior pointer，故报 possibly lost；并发反复 set/unset 时更易累积
# (实测 EnvironmentTest.ThreadSafety_ConcurrentGetSet 所在进程 8,317 字节 / 124 块)。
# 属 glibc 内部簿记，与项目代码无关；本项目测试均成对调用 set/unset。
# =============================================================================

{
   glibc_setenv_environ_bookkeeping
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:__add_to_environ
   ...
   fun:setenv
   ...
}

# =============================================================================
# crash_dump ELF core 写入自身内存段
# =============================================================================
# crash_dump 的 ELF 写入器按 /proc/self/maps 把自身的可读内存段 pwrite 到 core 文件，
# 其中 [heap] 映射的尾部超出进程断点 (brk)。原生运行时这些页可读（零填充），写入无
# 副作用；memcheck 只承认 brk 以内的堆内存，故把该 syscall 报为不可寻址来源。
# 仅匹配 crash_dump_elf 的 write_at 调用帧，其他 pwrite 错误仍会报告。
# =============================================================================

{
   crash_dump_elf_pwrite_heap_beyond_brk
   Memcheck:Param
   pwrite64(buf)
   ...
   fun:*write_at*
   ...
}
