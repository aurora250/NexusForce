        <briefdescription>
<para>检查两个序列是否为排列关系 </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>Iterator1</parametername>
</parameternamelist>
<parameterdescription>
<para>第一个迭代器类型 </para>
</parameterdescription>
