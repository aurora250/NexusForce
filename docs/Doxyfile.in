PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "A rigorously engineered full-stack C++ backend library."
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"

INPUT                  = "@DOXYGEN_INPUT_DIRS@" \
                         "@CMAKE_SOURCE_DIR@/docs/MAINPAGE.md"

RECURSIVE              = YES
MARKDOWN_SUPPORT       = YES

FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.md

HTML_DYNAMIC_SECTIONS  = NO
USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/docs/MAINPAGE.md"

PREDEFINED             = NEXUSFORCE_ENABLE_DOXYGEN=1 \
                         NEFORCE_USING_SSO \
                         NEFORCE_USING_INTEL_TSX \
                         NEFORCE_USING_IO_URING \
                         NEFORCE_SUPPORT_POSTGRESQL \
                         NEFORCE_SUPPORT_MYSQL \
                         NEFORCE_SUPPORT_SQLITE3 \
                         NEFORCE_SUPPORT_HIREDIS \
                         NEFORCE_SUPPORT_ZLIB \
                         NEFORCE_SUPPORT_LZ4 \
                         NEFORCE_SUPPORT_OPENSSL \
                         NEFORCE_SUPPORT_PCRE2 \
                         NEFORCE_SUPPORT_ICU \
                         NEFORCE_SUPPORT_SIMD \
                         NEFORCE_SUPPORT_INTEL_TSX \
                         NEFORCE_SUPPORT_INTRINSIC_INT128 \
                         NEFORCE_STANDARD_23 \
                         NEFORCE_STANDARD_20 \
                         NEFORCE_STANDARD_17 \
                         NEFORCE_STANDARD_14 \
                         NEFORCE_PLATFORM_WINDOWS \
                         NEFORCE_PLATFORM_WINDOWS32 \
                         NEFORCE_PLATFORM_WINDOWS64 \
                         NEFORCE_PLATFORM_LINUX \
                         NEFORCE_PLATFORM_LINUX32 \
                         NEFORCE_PLATFORM_LINUX64 \
                         NEFORCE_COMPILER_GNUC \
                         NEFORCE_COMPILER_CLANG \
                         NEFORCE_COMPILER_MINGW \
                         NEFORCE_COMPILER_GCC \
                         NEFORCE_COMPILER_MSVC \
                         NEFORCE_COMPILER_LLVM_MINGW \
                         NEFORCE_COMPILER_CLANG_CL \
                         NEFORCE_ARCH_X86 \
                         NEFORCE_ARCH_X86_32 \
                         NEFORCE_ARCH_X86_64 \
                         NEFORCE_ARCH_ARM \
                         NEFORCE_ARCH_ARM32 \
                         NEFORCE_ARCH_AARCH64 \
                         NEFORCE_ARCH_RISCV \
                         NEFORCE_ARCH_RISCV32 \
                         NEFORCE_ARCH_RISCV64 \
                         NEFORCE_ARCH_LOONGARCH \
                         NEFORCE_ARCH_LOONGARCH32 \
                         NEFORCE_ARCH_LOONGARCH64 \
                         NEFORCE_SIMD_SSE2 \
                         NEFORCE_SIMD_AVX \
                         NEFORCE_SIMD_AVX2 \
                         NEFORCE_SIMD_AVX512F \
                         NEFORCE_SIMD_SSSE3 \
                         NEFORCE_SIMD_NEON \
                         NEFORCE_SIMD_AES_NI \
                         NEFORCE_SIMD_AES_ARM \
                         NEFORCE_ARCH_BITS_64 \
                         NEFORCE_ARCH_BITS_32 \
                         NEFORCE_API \
                         NEFORCE_CONSTEXPR14=constexpr \
                         NEFORCE_CONSTEXPR17=constexpr \
                         NEFORCE_INLINE17=inline \
                         NEFORCE_CONSTEXPR20=constexpr \
                         NEFORCE_CONSTEVAL20=consteval \
                         NEFORCE_CONSTEXPR23=constexpr \
                         NEFORCE_PURE_FUNCTION \
                         NEFORCE_CONST_FUNCTION \
                         NEFORCE_ALLOC_OPTIMIZE \
                         "NEFORCE_ALWAYS_INLINE=inline" \
                         "NEFORCE_ALWAYS_INLINE_INLINE=inline" \
                         "NEFORCE_NODISCARD=[[nodiscard]]" \
                         "NEFORCE_ALLOC_NODISCARD=[[nodiscard]]" \
                         "NEFORCE_NORETURN=[[noreturn]]" \
                         "NEFORCE_DEPRECATED=[[deprecated]]" \
                         "NEFORCE_DEPRECATED_FOR(MSG)=[[deprecated(MSG)]]" \
                         NEFORCE_RESTRICT=__restrict \
                         NEFORCE_BEGIN_NAMESPACE__="namespace neforce {" \
                         NEFORCE_END_NAMESPACE__="}" \
                         NEFORCE_BEGIN_SIMD__="namespace simd {" \
                         NEFORCE_BEGIN_CONSTANTS__="namespace constants {" \
                         NEFORCE_BEGIN_THIS_THREAD__="namespace this_thread {" \
                         NEFORCE_BEGIN_RANGES__="namespace ranges {" \
                         NEFORCE_BEGIN_RANGES_VIEWS__="namespace views {" \
                         NEFORCE_BEGIN_LITERALS__="inline namespace literals {" \
                         NEFORCE_BEGIN_REFLECT__="namespace reflect {" \
                         NEFORCE_BEGIN_SERIALIZE__="namespace serialize {" \
                         NEFORCE_BEGIN_HTTP__="namespace http {" \
                         NEFORCE_BEGIN_TUI__="namespace tui {" \
                         NEFORCE_BEGIN_COMPONENTS__="namespace components {" \
                         NEFORCE_END_SIMD__="}" \
                         NEFORCE_END_CONSTANTS__="}" \
                         NEFORCE_END_THIS_THREAD__="}" \
                         NEFORCE_END_RANGES__="}" \
                         NEFORCE_END_RANGES_VIEWS__="}" \
                         NEFORCE_END_LITERALS__="}" \
                         NEFORCE_END_REFLECT__="}" \
                         NEFORCE_END_SERIALIZE__="}" \
                         NEFORCE_END_HTTP__="}" \
                         NEFORCE_END_TUI__="}" \
                         NEFORCE_END_COMPONENTS__="}"

OUTPUT_LANGUAGE        = Chinese

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = YES

HTML_OUTPUT            = html
LATEX_OUTPUT           = latex
RTF_OUTPUT             = rtf
MAN_OUTPUT             = man
XML_OUTPUT             = xml

EXTRACT_ALL            = NO      # 只提取有文档的内容
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO

SHOW_FILES             = YES
SHOW_INCLUDE_FILES     = YES     # 查看实现文件内容
SOURCE_BROWSER         = YES     # 源代码浏览
INLINE_SOURCES         = NO      # 在文档中嵌入源代码
INLINE_SIMPLE_STRUCTS  = NO      # 在文档中嵌入简单类定义
REFERENCES_LINK_SOURCE = YES     # 链接到源码
REFERENCED_BY_RELATION = YES     # 显示被引用关系
REFERENCES_RELATION    = YES     # 显示引用关系
BRIEF_MEMBER_DESC      = YES     # 简化变量文档

HIDE_UNDOC_MEMBERS     = YES     # 隐藏未文档化的成员
HIDE_UNDOC_CLASSES     = YES     # 隐藏未文档化的类
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES     # 隐藏所有初始值，适用于宏、变量

GRAPHICAL_HIERARCHY    = YES     # 图形化继承层次
INCLUDE_GRAPH          = YES     # 包含关系图
INCLUDED_BY_GRAPH      = NO      # 被包含关系图
COLLABORATION_GRAPH    = NO      # 协作图
UML_LOOK               = NO      # 简化 UML 样式

HAVE_DOT               = @HAVE_DOT@
DOT_NUM_THREADS        = 0       # 使用所有 CPU 核心
DOT_GRAPH_MAX_NODES    = 100     # 限制节点数量
MAX_DOT_GRAPH_DEPTH    = 10      # 限制图表深度
DOT_IMAGE_FORMAT       = svg     # 使用 SVG，更小更清晰

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO      # 是否使用PHP搜索引擎

ALPHABETICAL_INDEX     = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
DISABLE_INDEX          = NO

HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

FULL_PATH_NAMES        = NO      # 使用相对路径
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

AUTOLINK_SUPPORT       = YES
TYPEDEF_HIDES_STRUCT   = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO      # 警告未文档化的内容
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO      # 警告缺少参数文档

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
SKIP_FUNCTION_MACROS   = NO

LOOKUP_CACHE_SIZE      = 0       # 解析深度自动调整
