@PACKAGE_INIT@

set(MSTL_VERSION @PROJECT_VERSION@)
set(MSTL_ENABLE_MYSQL @MSTL_ENABLE_MYSQL@)
set(MSTL_ENABLE_SQLITE3 @MSTL_ENABLE_SQLITE3@)
set(MSTL_ENABLE_REDIS @MSTL_ENABLE_REDIS@)
set(MSTL_ENABLE_POSTGRESQL @MSTL_ENABLE_POSTGRESQL@)
set(MSTL_ENABLE_CUDA @MSTL_ENABLE_CUDA@)
set(MSTL_ENABLE_ZLIB @MSTL_ENABLE_ZLIB@)
set(MSTL_ENABLE_OPENSSL @MSTL_ENABLE_OPENSSL@)

include(CMakeFindDependencyMacro)

if(@MSTL_ENABLE_ZLIB@)
    find_dependency(ZLIB)

    if(NOT ZLIB_FOUND AND NOT TARGET ZLIB::ZLIB)
        if(WIN32)
            message(WARNING "zlib not found. Please install zlib or set ZLIB_ROOT_DIR")
            message(STATUS "  You can download zlib from: https://zlib.net/")
            message(STATUS "  Set ZLIB_ROOT_DIR to the installation directory")
        else()
            message(WARNING "zlib not found. Please install the development package:")
            message(STATUS "  Ubuntu/Debian: sudo apt-get install zlib1g-dev")
            message(STATUS "  CentOS/RHEL: sudo yum install zlib-devel")
            message(STATUS "  macOS: brew install zlib")
        endif()
    endif()
endif()

if(@MSTL_ENABLE_OPENSSL@)
    find_dependency(OpenSSL)
    
    if(NOT OpenSSL_FOUND)
        message(WARNING "OpenSSL not found. Required for some MSTL features")
        if(WIN32)
            message(STATUS "  Download OpenSSL from: https://slproweb.com/products/Win32OpenSSL.html")
            message(STATUS "  Set OpenSSL_ROOT_DIR to the installation directory")
        else()
            message(STATUS "  Ubuntu/Debian: sudo apt-get install libssl-dev")
            message(STATUS "  CentOS/RHEL: sudo yum install openssl-devel")
            message(STATUS "  macOS: brew install openssl")
        endif()
    endif()
endif()

if(@MSTL_ENABLE_CUDA@)
    find_dependency(CUDAToolkit)
endif()

if(@MSTL_ENABLE_POSTGRESQL@)
    if(WIN32)
        find_path(PostgreSQL_INCLUDE_DIR 
            NAMES libpq-fe.h
            PATHS 
                "C:/Program Files/PostgreSQL/*/include"
                "D:/PostgreSQL/18/include"
                "$ENV{POSTGRESQL_ROOT}/include"
            DOC "PostgreSQL include directory"
        )
        
        find_library(PostgreSQL_LIBRARY 
            NAMES libpq pq
            PATHS 
                "C:/Program Files/PostgreSQL/*/lib"
                "D:/PostgreSQL/18/lib"
                "$ENV{POSTGRESQL_ROOT}/lib"
            DOC "PostgreSQL library"
        )
        
        if(PostgreSQL_INCLUDE_DIR AND PostgreSQL_LIBRARY)
            set(PostgreSQL_FOUND TRUE)
            if(NOT TARGET PostgreSQL::PostgreSQL)
                add_library(PostgreSQL::PostgreSQL UNKNOWN IMPORTED)
                set_target_properties(PostgreSQL::PostgreSQL PROPERTIES
                    IMPORTED_LOCATION "${PostgreSQL_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${PostgreSQL_INCLUDE_DIR}"
                )
            endif()
        endif()
    else()
        find_dependency(PostgreSQL)
    endif()
    
    if(NOT PostgreSQL_FOUND)
        message(STATUS "PostgreSQL not found - related MSTL features will be unavailable")
    endif()
endif()

if(@MSTL_ENABLE_MYSQL@)
    if(WIN32)
        find_path(MySQL_INCLUDE_DIR 
            NAMES mysql.h
            PATHS 
                "C:/Program Files/MySQL/*/include"
                "D:/MySQL/MySQL Server 8.0/include"
                "$ENV{MYSQL_DIR}/include"
            DOC "MySQL include directory"
        )
        
        find_library(MySQL_LIBRARY 
            NAMES libmysql mysqlclient
            PATHS 
                "C:/Program Files/MySQL/*/lib"
                "D:/MySQL/MySQL Server 8.0/lib"
                "$ENV{MYSQL_DIR}/lib"
            DOC "MySQL library"
        )
        
        if(MySQL_INCLUDE_DIR AND MySQL_LIBRARY)
            set(MySQL_FOUND TRUE)
            if(NOT TARGET MySQL::MySQL)
                add_library(MySQL::MySQL UNKNOWN IMPORTED)
                set_target_properties(MySQL::MySQL PROPERTIES
                    IMPORTED_LOCATION "${MySQL_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${MySQL_INCLUDE_DIR}"
                )
            endif()
        endif()
    else()
        find_path(MySQL_INCLUDE_DIR 
            NAMES mysql.h
            PATHS /usr/include/mysql /usr/local/include/mysql
            DOC "MySQL include directory"
        )
        
        find_library(MySQL_LIBRARY 
            NAMES mysqlclient
            PATHS /usr/lib /usr/local/lib
            DOC "MySQL library"
        )
        
        if(MySQL_INCLUDE_DIR AND MySQL_LIBRARY)
            set(MySQL_FOUND TRUE)
            if(NOT TARGET MySQL::MySQL)
                add_library(MySQL::MySQL UNKNOWN IMPORTED)
                set_target_properties(MySQL::MySQL PROPERTIES
                    IMPORTED_LOCATION "${MySQL_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${MySQL_INCLUDE_DIR}"
                )
            endif()
        endif()
    endif()
    
    if(NOT MySQL_FOUND)
        message(STATUS "MySQL not found - related MSTL features will be unavailable")
    endif()
endif()

if(@MSTL_ENABLE_SQLITE3@)
    find_dependency(SQLite3)
    
    if(NOT SQLite3_FOUND)
        message(STATUS "SQLite3 not found - related MSTL features will be unavailable")
    endif()
endif()

if(@MSTL_ENABLE_REDIS@)
    if(WIN32)
        find_path(HIREDIS_INCLUDE_DIR 
            NAMES hiredis/hiredis.h
            PATHS 
                "$ENV{HIREDIS_ROOT}/include"
                "D:/vcpkg/packages/hiredis_x64-windows/include"
            DOC "hiredis include directory"
        )
        
        find_library(HIREDIS_LIBRARY 
            NAMES hiredis
            PATHS 
                "$ENV{HIREDIS_ROOT}/lib"
                "D:/vcpkg/packages/hiredis_x64-windows/lib"
            DOC "hiredis library"
        )
        
        if(HIREDIS_INCLUDE_DIR AND HIREDIS_LIBRARY)
            set(HIREDIS_FOUND TRUE)
            if(NOT TARGET Hiredis::Hiredis)
                add_library(Hiredis::Hiredis UNKNOWN IMPORTED)
                set_target_properties(Hiredis::Hiredis PROPERTIES
                    IMPORTED_LOCATION "${HIREDIS_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${HIREDIS_INCLUDE_DIR}"
                )
            endif()
        endif()
    else()
        find_path(HIREDIS_INCLUDE_DIR 
            NAMES hiredis/hiredis.h
            PATHS /usr/include /usr/local/include
            DOC "hiredis include directory"
        )
        
        find_library(HIREDIS_LIBRARY 
            NAMES hiredis
            PATHS /usr/lib /usr/local/lib
            DOC "hiredis library"
        )
        
        if(HIREDIS_INCLUDE_DIR AND HIREDIS_LIBRARY)
            set(HIREDIS_FOUND TRUE)
            if(NOT TARGET Hiredis::Hiredis)
                add_library(Hiredis::Hiredis UNKNOWN IMPORTED)
                set_target_properties(Hiredis::Hiredis PROPERTIES
                    IMPORTED_LOCATION "${HIREDIS_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${HIREDIS_INCLUDE_DIR}"
                )
            endif()
        endif()
    endif()
    
    if(NOT HIREDIS_FOUND)
        message(STATUS "Redis (hiredis) not found - related MSTL features will be unavailable")
    endif()
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(MSTL_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib/Debug")
elseif(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
    set(MSTL_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib/RelWithDebInfo")
elseif(CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
    set(MSTL_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib/MinSizeRel")
else()
    set(MSTL_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib/Release")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MSTLTargets.cmake")

check_required_components(MSTL)

set(MSTL_FOUND TRUE)
set(MSTL_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(MSTL_LIBRARY_DIRS "${MSTL_LIBRARY_DIR}")

set(MSTL_INCLUDE_DIR ${MSTL_INCLUDE_DIRS})
set(MSTL_LIBRARY_DIR ${MSTL_LIBRARY_DIRS})

message(STATUS "Found MSTL ${MSTL_VERSION}")
message(STATUS "  Include directory: ${MSTL_INCLUDE_DIR}")
message(STATUS "  Library directory: ${MSTL_LIBRARY_DIR}")
message(STATUS "  Features enabled:")
message(STATUS "    MySQL:        ${MSTL_ENABLE_MYSQL}")
message(STATUS "    SQLite3:      ${MSTL_ENABLE_SQLITE3}")
message(STATUS "    Redis:        ${MSTL_ENABLE_REDIS}")
message(STATUS "    PostgreSQL:   ${MSTL_ENABLE_POSTGRESQL}")
message(STATUS "    CUDA:         ${MSTL_ENABLE_CUDA}")
message(STATUS "    zlib:         ${MSTL_ENABLE_ZLIB}")
message(STATUS "    OpenSSL:      ${MSTL_ENABLE_OPENSSL}")

set(MSTL_DEFINITIONS)
if(MSTL_ENABLE_MYSQL AND MySQL_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_MYSQL__)
endif()
if(MSTL_ENABLE_SQLITE3 AND SQLite3_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_SQLITE3__)
endif()
if(MSTL_ENABLE_REDIS AND HIREDIS_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_REDIS__)
endif()
if(MSTL_ENABLE_POSTGRESQL AND PostgreSQL_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_POSTGRESQL__)
endif()
if(MSTL_ENABLE_CUDA AND CUDAToolkit_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_CUDA__)
endif()
if(MSTL_ENABLE_ZLIB AND ZLIB_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_ZLIB__)
endif()
if(MSTL_ENABLE_OPENSSL AND OpenSSL_FOUND)
    list(APPEND MSTL_DEFINITIONS MSTL_SUPPORT_OPENSSL__)
endif()

if(TARGET MSTL::MSTL)
    target_compile_definitions(MSTL::MSTL INTERFACE ${MSTL_DEFINITIONS})

    if(MSTL_ENABLE_MYSQL AND TARGET MySQL::MySQL)
        target_link_libraries(MSTL::MSTL INTERFACE MySQL::MySQL)
    endif()
    if(MSTL_ENABLE_SQLITE3 AND TARGET SQLite::SQLite3)
        target_link_libraries(MSTL::MSTL INTERFACE SQLite::SQLite3)
    endif()
    if(MSTL_ENABLE_REDIS AND TARGET Hiredis::Hiredis)
        target_link_libraries(MSTL::MSTL INTERFACE Hiredis::Hiredis)
    endif()
    if(MSTL_ENABLE_POSTGRESQL AND TARGET PostgreSQL::PostgreSQL)
        target_link_libraries(MSTL::MSTL INTERFACE PostgreSQL::PostgreSQL)
    endif()
    if(MSTL_ENABLE_CUDA AND TARGET CUDA::cudart)
        target_link_libraries(MSTL::MSTL INTERFACE CUDA::cudart)
    endif()
    if(MSTL_ENABLE_ZLIB AND TARGET ZLIB::ZLIB)
        target_link_libraries(MSTL::MSTL INTERFACE ZLIB::ZLIB)
    endif()
    if(MSTL_ENABLE_OPENSSL AND TARGET OpenSSL::SSL AND TARGET OpenSSL::Crypto)
        target_link_libraries(MSTL::MSTL INTERFACE OpenSSL::SSL OpenSSL::Crypto)
    endif()
endif()
