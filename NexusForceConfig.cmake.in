@PACKAGE_INIT@

set(NEXUSFORCE_VERSION @NEXUSFORCE_VERSION@)
set(NEXUSFORCE_ENABLE_POSTGRESQL @NEXUSFORCE_ENABLE_POSTGRESQL@)
set(NEXUSFORCE_ENABLE_MYSQL @NEXUSFORCE_ENABLE_MYSQL@)
set(NEXUSFORCE_ENABLE_SQLITE3 @NEXUSFORCE_ENABLE_SQLITE3@)
set(NEXUSFORCE_ENABLE_REDIS @NEXUSFORCE_ENABLE_REDIS@)
set(NEXUSFORCE_ENABLE_ZLIB @NEXUSFORCE_ENABLE_ZLIB@)
set(NEXUSFORCE_ENABLE_LZ4 @NEXUSFORCE_ENABLE_LZ4@)
set(NEXUSFORCE_USING_SSO @NEXUSFORCE_USING_SSO@)
set(NEXUSFORCE_USING_INTEL_TSX @NEXUSFORCE_USING_INTEL_TSX@)
set(NEXUSFORCE_USING_SQLCIPHER @NEXUSFORCE_USING_SQLCIPHER@)


include(CMakeFindDependencyMacro)


if(@NEXUSFORCE_ENABLE_POSTGRESQL@)
    find_dependency(PostgreSQL)
endif()

if(@NEXUSFORCE_ENABLE_MYSQL@)
    find_dependency(unofficial-libmysql CONFIG)
endif()

if(@NEXUSFORCE_ENABLE_SQLITE3@)
    if(@NEXUSFORCE_SQLCIPHER_LINKED@)
        find_dependency(sqlcipher CONFIG)
    else()
        find_dependency(unofficial-sqlite3 CONFIG)
    endif()
endif()

if(@NEXUSFORCE_ENABLE_REDIS@)
    find_dependency(hiredis CONFIG)
endif()

if(@NEXUSFORCE_ENABLE_ZLIB@)
    find_dependency(ZLIB)
endif()

if(@NEXUSFORCE_ENABLE_LZ4@)
    find_dependency(lz4 CONFIG)
endif()

find_dependency(OpenSSL COMPONENTS Crypto SSL)
find_dependency(pcre2 CONFIG COMPONENTS 8BIT)

find_dependency(Threads)


include("${CMAKE_CURRENT_LIST_DIR}/NexusForceCompilerOptions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NexusForceTargets.cmake")

get_target_property(NEXUSFORCE_INCLUDE_DIRS NexusForce::NexusForce INTERFACE_INCLUDE_DIRECTORIES)
set(NEXUSFORCE_LIBRARIES NexusForce::NexusForce)
set(NEXUSFORCE_FOUND TRUE)


message(STATUS "Found NexusForce ${NEXUSFORCE_VERSION}")
message(STATUS "")
message(STATUS "  NEXUSFORCE_ENABLE_POSTGRESQL:   ${NEXUSFORCE_ENABLE_POSTGRESQL}")
message(STATUS "  NEXUSFORCE_ENABLE_MYSQL:        ${NEXUSFORCE_ENABLE_MYSQL}")
message(STATUS "  NEXUSFORCE_ENABLE_SQLITE3:      ${NEXUSFORCE_ENABLE_SQLITE3}")
message(STATUS "  NEXUSFORCE_ENABLE_REDIS:        ${NEXUSFORCE_ENABLE_REDIS}")
message(STATUS "  NEXUSFORCE_ENABLE_ZLIB:         ${NEXUSFORCE_ENABLE_ZLIB}")
message(STATUS "  NEXUSFORCE_ENABLE_LZ4:          ${NEXUSFORCE_ENABLE_LZ4}")
message(STATUS "  NEXUSFORCE_ENABLE_OPENSSL:      ON (NECESSARY)")
message(STATUS "  NEXUSFORCE_ENABLE_PCRE2:        ON (NECESSARY)")
message(STATUS "")
message(STATUS "  NEXUSFORCE_USING_SSO:           ${NEXUSFORCE_USING_SSO}")
message(STATUS "  NEXUSFORCE_USING_INTEL_TSX:     ${NEXUSFORCE_USING_INTEL_TSX}")
message(STATUS "  NEXUSFORCE_USING_SQLCIPHER:     ${NEXUSFORCE_USING_SQLCIPHER}")
message(STATUS "")
